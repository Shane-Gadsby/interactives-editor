{"format":"interactives","version":1,"id":"pr2c2dh5rygewa3","name":"Spell it","created":"2026-11-10T02:20:28.805Z","updated":"2026-11-10T02:20:28.805Z","artboards":[{"id":"ab2c2dh5q9qgg00","name":"Home","width":800,"height":600,"background":{"type":"solid","color":"token:tk2c2dh5s1fwu05"},"canvasX":0,"canvasY":0,"children":[{"id":"n2c2di6doc2sa1","type":"text","name":"Question","x":60,"y":80,"width":680,"height":42,"rotation":0,"scaleX":1,"scaleY":1,"originX":0.5,"originY":0.5,"opacity":1,"visible":true,"fontFamily":"\"Open Sans\", system-ui, sans-serif","fontSize":30,"fontWeight":700,"fontStyle":"normal","lineHeight":1.3,"letterSpacing":0,"color":"token:tk2c2dh5vcx5o9k","align":"left","verticalAlign":"top","text":"Name the largest moon in the solar system.","autoSize":"height"},{"id":"n2c2di6e49dfz7","type":"text","name":"Hint","x":60,"y":136,"width":680,"height":26,"rotation":0,"scaleX":1,"scaleY":1,"originX":0.5,"originY":0.5,"opacity":1,"visible":true,"fontFamily":"\"Open Sans\", system-ui, sans-serif","fontSize":18,"fontWeight":400,"fontStyle":"normal","lineHeight":1.3,"letterSpacing":0,"color":"token:tk2c2dh5vcx5o9k","align":"left","verticalAlign":"top","text":"It goes round Jupiter.","autoSize":"height"},{"id":"n2c2di6f2v7wsu","type":"input","name":"Answer box","x":60,"y":200,"width":360,"height":48,"rotation":0,"scaleX":1,"scaleY":1,"originX":0.5,"originY":0.5,"opacity":1,"visible":true,"fontFamily":"\"Open Sans\", system-ui, sans-serif","fontSize":18,"fontWeight":400,"fontStyle":"normal","lineHeight":1.3,"letterSpacing":0,"color":"token:tk2c2dh5vcx5o9k","align":"left","verticalAlign":"top","fill":{"type":"solid","color":"token:tk2c2dh5s1fwu05"},"stroke":{"paint":{"type":"solid","color":"token:tk2c2dh62ndkvwa"},"width":1},"inputType":"text","placeholder":"Type the moon's name","value":"","cornerRadius":6,"noAssist":true,"bindings":{"value":"answer"},"bindingModes":{"value":"both"}},{"id":"n2c2di6gbsd3cg","type":"button","name":"Check","x":440,"y":200,"width":160,"height":48,"rotation":0,"scaleX":1,"scaleY":1,"originX":0.5,"originY":0.5,"opacity":1,"visible":true,"fontFamily":"\"Open Sans\", system-ui, sans-serif","fontSize":18,"fontWeight":700,"fontStyle":"normal","lineHeight":1.3,"letterSpacing":0,"color":"token:tk2c2dh61qkbtbt","align":"center","verticalAlign":"middle","fill":{"type":"solid","color":"token:tk2c2dh600hvbxv"},"stroke":null,"label":"Check","cornerRadius":6},{"id":"n2c2di6hagrulm","type":"text","name":"Feedback","x":60,"y":280,"width":680,"height":30,"rotation":0,"scaleX":1,"scaleY":1,"originX":0.5,"originY":0.5,"opacity":1,"visible":true,"fontFamily":"\"Open Sans\", system-ui, sans-serif","fontSize":20,"fontWeight":400,"fontStyle":"normal","lineHeight":1.3,"letterSpacing":0,"color":"token:tk2c2dh5vcx5o9k","align":"left","verticalAlign":"top","text":"Feedback","autoSize":"height","bindings":{"text":"distance < 0 ? \"\" : distance == 0 ? \"Right! Ganymede is the largest moon in the solar system.\" : distance <= 2 ? \"Right, nearly. It is spelt Ganymede.\" : \"Not quite. Try again.\""}}],"timelines":[],"logic":{"nodes":[{"id":"ln2c2di6jc152wj","kind":"event.pointer","x":0,"y":0,"params":{"target":"n2c2di6gbsd3cg","type":"click"}},{"id":"ln2c2di6kbuwcyv","kind":"action.script","x":280,"y":0,"params":{"script":"sc2c2di6i0t8aii"}}],"edges":[{"id":"le2c2di6l330ja3","from":"ln2c2di6jc152wj","fromPort":"out","to":"ln2c2di6kbuwcyv","toPort":"in"}]},"clip":true,"notes":[{"id":"note_example_tut_script_1","x":836,"y":0,"w":260,"h":125,"text":"**The script is in the Scripts tab**, called *Close enough*. It only works out one number, `distance`, and Run on start is off: the Check button runs it.","author":"Example"},{"id":"note_example_tut_script_2","x":0,"y":636,"w":260,"h":144,"text":"**The words are not in the script.** Select *Feedback* and look under Data bindings: its Text is a formula of `distance`, so you can change what it says without touching code.","colour":"sky","author":"Example"}]}],"variables":[{"id":"v2c2di6b5kv4s7","name":"answer","type":"string","initial":""},{"id":"v2c2di6cd9vm8l","name":"distance","type":"number","initial":-1}],"scripts":[{"id":"sc2c2di6i0t8aii","name":"Close enough","code":"// How many letters would have to change to turn what was typed into the answer.\n// 0 is spelt right, 1 or 2 is a near miss. The words on the page are worked out from it by a binding.\nconst typed = String(ix.vars.answer).trim().toLowerCase();\nconst target = 'ganymede';\n\nlet row = [];\nfor (let j = 0; j <= target.length; j++) row.push(j);\nfor (let i = 1; i <= typed.length; i++) {\n  const next = [i];\n  for (let j = 1; j <= target.length; j++) {\n    const change = typed[i - 1] === target[j - 1] ? 0 : 1;\n    next[j] = Math.min(row[j] + 1, next[j - 1] + 1, row[j - 1] + change);\n  }\n  row = next;\n}\nix.vars.distance = row[target.length];\n","runOnStart":false}],"assets":[],"fonts":[],"dataSources":[],"settings":{"startArtboardId":"ab2c2dh5q9qgg00","fit":"contain","pageBackground":"#111111","title":"Spell it","description":"","scriptSandbox":true,"optimiseOutput":true,"optimiseLevel":4},"themes":{"list":[{"id":"theme-light","name":"Light","mode":"light"},{"id":"theme-dark","name":"Dark","mode":"dark"},{"id":"theme-high-contrast","name":"High contrast","mode":"dark","highContrast":true}],"tokens":[{"id":"tk2c2dh5s1fwu05","name":"color/background","values":{"theme-light":"#fefefe","theme-dark":"#1e1e1e","theme-high-contrast":"#1e1e1e"},"palette":{"theme-light":"--ilar-swatch-off-white","theme-dark":"--ilar-swatch-grey-7","theme-high-contrast":"--ilar-swatch-grey-7"}},{"id":"tk2c2dh5tfztj7o","name":"color/surface","values":{"theme-light":"#f4f4f4","theme-dark":"#333333","theme-high-contrast":"#1e1e1e"},"palette":{"theme-light":"--ilar-swatch-grey-1","theme-dark":"--ilar-swatch-grey-text","theme-high-contrast":"--ilar-swatch-grey-7"}},{"id":"tk2c2dh5u5ayeh1","name":"color/surface-muted","values":{"theme-light":"#dfdfdf","theme-dark":"#4d4d4d","theme-high-contrast":"#4d