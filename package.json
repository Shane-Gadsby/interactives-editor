{
  "name": "interactives-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based editor for Interactives: artboards, vector and web elements, timelines, node-based interactions and custom JavaScript.",
  "license": "MIT",
  "scripts": {
    "player:build": "npm --prefix ../interactives-player run build",
    "predev": "npm run player:build",
    "dev": "vite",
    "prebuild": "npm run player:build",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "node index.js",
    "server": "nodemon index.js"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@xyflow/react": "^12.12.1",
    "codemirror": "^6.0.2",
    "fake-indexeddb": "^6.2.7",
    "fflate": "^0.8.3",
    "immer": "^10.2.0",
    "jsdom": "^25.0.1",
    "polygon-clipping": "^0.15.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "main": "index.js",
  "author": "Shane Gadsby",
  "overrides": {
    "qs": "^6.16.0"
  }
}
